# This repository is the marketplace + the plugin source. It carries no user memory:
# a user's MEMORY.md, handoffs and knowledge live in THEIR repo, scaffolded by
# /memory-kit:setup (which also writes the matching .gitignore lines there).

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/

# Local scratch: this repo is not a memory workspace, but a maintainer may run the kit on it
.claude/

# OpenCode runtime bookkeeping generated next to the shim when a local checkout is used as a path plugin
.opencode/package.json
.opencode/package-lock.json
