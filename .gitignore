# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/

# Runtime state (never committed)
.claude/state/*
!.claude/state/.gitkeep

# Daily session logs (private by default — user can opt in to commit)
# handoffs are personal session notes — private by default
context/handoffs/*.md
!context/handoffs/HANDOFF-TEMPLATE.md
# (advanced daily-chronicle layer, if enabled — see .kit/advanced/close-day-layer/)
daily/*.md
!daily/README.md
!daily/TEMPLATE.md
